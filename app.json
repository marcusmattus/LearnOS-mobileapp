{
  "expo": {
    "name": "LearnOS",
    "slug": "learnos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.learnos.learnosmobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.learnos.learnosmobile"
    },
    "scheme": "learnos",
    "backgroundColor": "#0B0B12",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B12",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B0B12"
          }
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "LearnOS uses your camera to scan books, pages and notes so it can build a learning path from them."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LearnOS needs access to your photos so you can import pages and build a learning path from them."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "08dcdca5-47d5-400c-bc55-6ac5b90e8c48"
      },
      "scanApiUrl": "http://localhost:3000",
      "scanApiKey": ""
    }
  }
}
