# Required — the scan endpoint calls Claude with this key.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional — if set, the app must send a matching `x-learnos-key` header
# (configured in the app's app.json under expo.extra.scanApiKey).
# A lightweight deterrent against random requests hitting your endpoint and
# spending your Anthropic credits, not real per-user authentication.
APP_SHARED_SECRET=
